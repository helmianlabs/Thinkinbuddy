{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/image.js": { "maxDuration": 300 },
    "api/video.js": { "maxDuration": 300 },
    "api/extract-memories.js": { "maxDuration": 30 },
    "api/browse.js": { "maxDuration": 30 },
    "api/search.js": { "maxDuration": 30 },
    "api/diary.js": { "maxDuration": 60 },
    "api/mcp.js": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/cron-expire-memories",
      "schedule": "0 7 * * *"
    }
  ]
}
