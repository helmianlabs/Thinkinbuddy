# ThinkinBuddy — environment variables
#
# Copy this file to `.env.local` (Vite/dev) and set the same keys in your
# Vercel project settings for production. Every value below is a PLACEHOLDER —
# replace with your own account's key. Nothing in this file is a real secret.
#
# Endpoints are Vercel serverless functions under /api. Two auth styles are
# used (see lib/security.js): browser calls are gated by ALLOWED_ORIGINS
# (CORS), and server-to-server calls from the ElevenLabs agent's tool
# webhooks are gated by WEBHOOK_SECRET (X-Webhook-Secret header).

# ── Core voice agent (required) ─────────────────────────────────────────
# Your ElevenLabs API key. Create an agent in the ElevenLabs dashboard
# (Conversational AI -> Agents), then paste its ID into the app config.
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here
# HMAC secret ElevenLabs signs post-call webhook payloads with — set the
# same value in the agent's webhook config. See api/conversation-webhook.js.
ELEVENLABS_POSTCALL_WEBHOOK_SECRET=your_postcall_webhook_secret_here

# ── LLM / embeddings (required) ─────────────────────────────────────────
# Used for: image generation (gpt-image-2), moderation, memory embeddings
# (text-embedding-3-small), and the video start-frame pipeline.
OPENAI_API_KEY=sk-your_openai_api_key_here

# ── Persistent memory (required) ────────────────────────────────────────
# Neon Postgres connection string with the pgvector extension enabled.
# Run the migrations in docs/ (see docs/migration-media-memory-2026-06-06.sql
# and docs/persistent-memory-spec-2026-05-27.md) against this database
# before first use.
DATABASE_URL=postgres://user:password@your-neon-host/dbname?sslmode=require
# Optional second pool if you split conversation memory onto its own DB.
DATABASE_URL_MEMORY=postgres://user:password@your-neon-host/dbname?sslmode=require

# ── Generated media storage (required for images/video) ────────────────
# Vercel Blob read/write token — Vercel dashboard -> Storage -> Blob.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ── Web/API security (required) ─────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API
# (see lib/security.js DEFAULT_ALLOWED_ORIGINS for the fallback list).
ALLOWED_ORIGINS=https://your-deployment.vercel.app,http://localhost:5173
# Long random string shared with the ElevenLabs agent's tool webhook config
# (each custom tool's "Secret" header). Generate with `openssl rand -hex 32`.
WEBHOOK_SECRET=your_long_random_webhook_secret_here
# Secret for any authenticated cron-triggered routes.
CRON_SECRET=your_cron_secret_here

# ── Optional image generators (tool endpoints degrade gracefully if unset) ─
# Google Imagen — api/image-imagen.js
GOOGLE_API_KEY=your_google_ai_studio_key_here
# Replicate — Flux family — api/image-flux.js
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# ── Optional video generators (tool endpoints degrade gracefully if unset) ─
# Runway — api/video.js, api/video-runway.js, api/video-runway-veo.js
RUNWAY_API_KEY=your_runway_api_key_here
# HeyGen avatar video — api/video-heygen.js
HEYGEN_API_KEY=your_heygen_api_key_here
# OpenAI Sora — api/video-sora.js (uses OPENAI_API_KEY above; no separate key)

# ── Optional: secondary LLMs for the "Actionable" assistant module ──────
ANTHROPIC_API_KEY=sk-ant-your_key_here
ACTIONABLE_API_KEY=your_actionable_module_key_here
ACTIONABLE_ALLOW_ORIGIN=http://localhost:5173
ACTIONABLE_ANTHROPIC_MODEL=claude-sonnet-4-5
ACTIONABLE_GEMINI_MODEL=gemini-2.5-pro
ACTIONABLE_OPENAI_MODEL=gpt-4.1
ACTIONABLE_STATE_SECRET=your_actionable_state_secret_here

# ── Optional: Google Docs / Sheets export (diary + scribe features) ─────
# OAuth client for a Google Apps Script / Docs-writing integration —
# see scribe/PushToScribe.gs and scribe/DEPLOY_INSTRUCTIONS.md.
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-deployment.vercel.app/api/oauth/google/callback
# Apps Script Web App URL that receives diary entries (writes to Sheets).
SHEETS_DIARY_WEBHOOK=https://script.google.com/macros/s/your-deployment-id/exec
# Apps Script Web App URL that receives Scribe pushes (writes to Docs).
SCRIBE_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
DOCS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
DOCS_ACTIONABLE_WEBHOOK=https://script.google.com/macros/s/your-deployment-id/exec

# ── Optional: Notion / Todoist integrations (Actionable module) ─────────
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
TODOIST_CLIENT_ID=your_todoist_client_id
TODOIST_CLIENT_SECRET=your_todoist_client_secret
TODOIST_REDIRECT_URI=https://your-deployment.vercel.app/api/oauth/todoist/callback

# ── Optional: Helmion desktop relay (NOT required — the app runs standalone
# without this; see lib/helmion-relay.js, which no-ops cleanly if unset) ──
HELMION_RELAY_URL=https://your-deployment.vercel.app/api/relay-http
HELMION_RELAY_SECRET=your_helmion_relay_secret_here
HELMION_RELAY_CHANNEL=pilot
MCP_SECRET=your_mcp_secret_here

# ── Misc / feature flags ─────────────────────────────────────────────────
ENFORCE_TOOL_AUTH=true
DRY_RUN=false
